# Database connection URL used by SQLModel/SQLAlchemy.
# Defaults to the local Docker Compose Postgres container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pipeline

# OpenAI-compatible LLM credentials.
# Replace with a real key to enable mapping proposals and embeddings.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# WorkOS AuthKit configuration.
# Sign up at https://workos.com and create an AuthKit project.
# The Client ID is shown in the WorkOS Dashboard under your project's
# "Configuration > API Keys" (look for the value starting with `client_`).
# This is not the MCP / WorkOS MCP Server client ID.
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
WORKOS_REDIRECT_URI=http://localhost:8000/auth/callback
WORKOS_AUTHKIT_DOMAIN=https://auth.workos.com

# Session cookie encryption key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-in-production

# Session lifetime in seconds (default: 1 day).
SESSION_MAX_AGE=86400

# Set to true to bypass WorkOS login for local scripts and tests.
# Must be false in production / Azure deployments.
AUTH_BYPASS_LOCAL=true
