# Database connection URL used by SQLModel/SQLAlchemy.
# Defaults to the local Docker Compose Postgres container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pipeline
APP_ENVIRONMENT=local
# Required in production. These verified Clerk identities bootstrap platform
# administration and may create the first client invitations.
BOOTSTRAP_ADMIN_EMAILS=operator@example.com

# Leave GCS_BUCKET empty for local filesystem storage. Cloud Run sets this to
# use Cloud Storage and uses WORK_DIR as its ephemeral generation workspace.
GCS_BUCKET=
WORK_DIR=/tmp/pipeline-work

# Organizations supply both provider endpoints and API keys through Settings or
# request-scoped X-OpenAI-Api-Key and X-OpenAI-Base-Url headers.

# Clerk authentication. Configure the hosted sign-in return URL as
# http://localhost:8000/auth/callback. The named JWT template must include a
# verified `email` claim and use the audience configured below.
CLERK_PUBLISHABLE_KEY=pk_test_...
# Required to create Clerk-hosted email invitations from organization settings.
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=your-api-audience
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SIGN_IN_URL=https://your-clerk-instance.clerk.accounts.dev/sign-in
CLERK_JWT_TEMPLATE=pipeline-beta

# Session cookie encryption key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-in-production

# Session lifetime in seconds (default: 1 day).
SESSION_MAX_AGE=86400
SESSION_COOKIE_SECURE=false
PIPELINE_EXECUTION_TIMEOUT_SECONDS=120
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_SOURCE_FILES=10
MAX_TOTAL_UPLOAD_SIZE_BYTES=104857600
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=

# Set to true to bypass Clerk login for local scripts and tests.
# Must be false in production / GCP deployments.
AUTH_BYPASS_LOCAL=true
