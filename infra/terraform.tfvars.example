# Copy to terraform.tfvars. Do not commit terraform.tfvars or secret values.
project_id      = "your-gcp-project-id"
region          = "us-central1"
environment     = "dev"
project_name    = "pipeline"
github_repository = "your-github-org/your-repository"
artifact_bucket_name = "your-gcp-project-id-pipeline-dev-artifacts"
terraform_state_bucket_name = "your-gcp-project-id-pipeline-dev-tf-state"
serverless_vpc_subnet_cidr = "10.8.0.0/26"
secret_ids = {
  "database-url"        = "pipeline-dev-database-url"
  "session-secret-key"  = "pipeline-dev-session-secret-key"
  "byok-encryption-key" = "pipeline-dev-byok-encryption-key"
  "clerk-secret-key"    = "pipeline-dev-clerk-secret-key"
}
container_image = "us-central1-docker.pkg.dev/your-gcp-project-id/pipeline-dev/app:tag"

# Supply via TF_VAR_* variables or a secure CI secret store, not this file.
# postgres_password  = "..."
# session_secret_key = "..."
# byok_encryption_key = "..."
# clerk_secret_key   = "sk_..."
clerk_publishable_key = "pk_..."
clerk_issuer          = "https://your-clerk-instance.clerk.accounts.dev"
clerk_audience        = "your-api-audience"
clerk_jwks_url        = "https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json"
clerk_sign_in_url     = "https://your-clerk-instance.clerk.accounts.dev/sign-in"
clerk_jwt_template    = "pipeline-beta"
bootstrap_admin_emails = ["operator@example.com"]
min_instances       = 0
max_instances       = 10
