# Required Azure / Entra ID configuration (copy to terraform.tfvars and fill in).
#
# NOTE: secrets (database_password, azure_openai_api_key, session_secret_key,
# entra_client_secret) are written to Key Vault and referenced by the container
# app at runtime. They appear here only as input variables, never in state env.

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"
entra_tenant_id = "00000000-0000-0000-0000-000000000000"

environment = "dev"
location    = "eastus"

entra_client_id     = "00000000-0000-0000-0000-000000000000"
entra_client_secret = "replace-me"

azure_openai_api_key = "replace-me"

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
session_secret_key = "replace-me"

database_username = "popadmin"
# Min 8 chars, must include uppercase, lowercase, and number.
database_password = "replace-me"
