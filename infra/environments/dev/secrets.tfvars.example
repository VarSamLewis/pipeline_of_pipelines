# Copy this to secrets.tfvars and fill in real values. secrets.tfvars is
# gitignored; this example is committed.
#
#   cp infra/environments/dev/secrets.tfvars.example infra/environments/dev/secrets.tfvars
#
# Notes:
# - The Entra client secret is NOT here: it is auto-generated by Terraform and
#   stored in Key Vault (see docs/azure_setup_guide.md).
# - Generate the session secret with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"

database_password = "replace-me"            # min 8 chars: upper + lower + number

azure_openai_api_key = "replace-me"

session_secret_key = "replace-me"